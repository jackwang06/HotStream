# ── Next.js env template — copy to .env.local and fill in ──

# PostgreSQL (schema-scoped: rights only inside the named schema)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=wangyafei

# First admin, seeded by `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# The Python scraper/AI service that Next.js proxies to
PYTHON_API_BASE=http://127.0.0.1:5173
